# ==============================================================
# Sovereign Health Twin - Environment Configuration Template
# ==============================================================
# Keep secrets safe: NEVER commit .env files, private keys, or seed phrases.

# Application Configuration
APP_NAME=Sovereign Health Twin
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Authentication (Generate a strong 256-bit random secret in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database Configuration (SQLite default; PostgreSQL optional)
DATABASE_URL=sqlite:///./patient_twin.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_twin_db

# Web3 Blockchain Configuration (Optional: Omit for zero-config in-process EVM development)
# To connect to a local Ganache/Anvil node or remote Ethereum testnet (e.g. Sepolia):
# WEB3_PROVIDER_URL=http://127.0.0.1:8545
# WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# WEB3_PRIVATE_KEY=0x_YOUR_DEVELOPMENT_TESTNET_PRIVATE_KEY_HERE
# REGISTRY_CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS_HERE
